<!-- ══ MODAL ══ -->
<div class="pp-modal-overlay" id="editModal" onclick="closeOnOverlay(event)">
    <div class="pp-modal">
        <h2 class="pp-modal-title">✏️ Sửa thông tin cá nhân</h2>
        <form method="post" action="/User/EditProfile" id="editProfileForm" onsubmit="return validateEditForm()">
            <div class="pp-field">
                <label>Họ &amp; Tên</label>
                <input type="text" name="fullName" id="editFullName" required maxlength="100" />
                <span class="pp-field-err" id="errFullName"></span>
            </div>
            <div class="pp-field">
                <label>Số điện thoại</label>
                <input type="tel" name="phone" id="editPhone" maxlength="15" placeholder="Nhập số điện thoại" />
                <div class="pp-phone-warn" id="phoneWarn">
                    ⚠️ Số điện thoại dùng để đăng nhập. Sau khi đổi, bạn cần dùng số mới để đăng nhập.
                </div>
                <span class="pp-field-err" id="errPhone"></span>
            </div>
            <div class="pp-field">
                <label>Email</label>
                <input type="email" name="email" id="editEmail" maxlength="200" placeholder="Nhập email (không bắt buộc)" />
                <span class="pp-field-err" id="errEmail"></span>
            </div>
            <div class="pp-modal-actions">
                <button type="button" class="pp-btn-cancel" onclick="closeEditModal()">Hủy</button>
                <button type="submit" class="pp-btn-save">Lưu thay đổi</button>
            </div>
        </form>
    </div>
</div>

<script>
    var _name  = '@Html.Raw(displayName.Replace("'", "\\'"))';
    var _email = '@Html.Raw((email ?? "").Replace("'", "\\'"))';
    var _phone = '@Html.Raw((phone ?? "").Replace("'", "\\'"))';

    function openEditModal() {
        document.getElementById('editFullName').value = _name;
        document.getElementById('editPhone').value  = _phone === 'Chưa cập nhật' ? '' : _phone;
        document.getElementById('editEmail').value  = _email === 'Chưa cập nhật' ? '' : _email;
        clearErrors();
        document.getElementById('editModal').classList.add('open');
    }
    function closeEditModal() {
        document.getElementById('editModal').classList.remove('open');
    }
    function closeOnOverlay(e) {
        if (e.target === document.getElementById('editModal')) closeEditModal();
    }
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeEditModal(); });

    function clearErrors() {
        ['errFullName','errPhone','errEmail'].forEach(id => {
            document.getElementById(id).textContent = '';
        });
        ['editFullName','editPhone','editEmail'].forEach(id => {
            document.getElementById(id).style.borderColor = '';
        });
    }

    function setError(inputId, errId, msg) {
        document.getElementById(errId).textContent = msg;
        document.getElementById(inputId).style.borderColor = '#ef4444';
    }

    function validateEditForm() {
        clearErrors();
        let valid = true;

        const name  = document.getElementById('editFullName').value.trim();
        const phone = document.getElementById('editPhone').value.trim();
        const email = document.getElementById('editEmail').value.trim();

        if (!name) {
            setError('editFullName', 'errFullName', 'Họ & Tên không được để trống.');
            valid = false;
        } else if (name.length < 2) {
            setError('editFullName', 'errFullName', 'Họ & Tên phải có ít nhất 2 ký tự.');
            valid = false;
        }

        if (phone && !/^(0[3|5|7|8|9])[0-9]{8}$/.test(phone)) {
            setError('editPhone', 'errPhone', 'Số điện thoại không hợp lệ (VD: 0912345678).');
            valid = false;
        }

        if (email && !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email)) {
            setError('editEmail', 'errEmail', 'Địa chỉ email không hợp lệ.');
            valid = false;
        }

        return valid;
    }

    // Realtime clear error on input
    ['editFullName','editPhone','editEmail'].forEach(id => {
        document.getElementById(id)?.addEventListener('input', function() {
            this.style.borderColor = '';
            const errMap = { editFullName:'errFullName', editPhone:'errPhone', editEmail:'errEmail' };
            document.getElementById(errMap[id]).textContent = '';
        });
    });

    // Phone change warning
    document.getElementById('editPhone')?.addEventListener('input', function() {
        const warn = document.getElementById('phoneWarn');
        const originalPhone = _phone === 'Chưa cập nhật' ? '' : _phone;
        warn.style.display = this.value.trim() !== originalPhone ? 'block' : 'none';
    });

    // ── Change Password Modal ──
    function openChangePwModal() {
        ['oldPassword','newPassword','confirmPassword'].forEach(id => {
            const el = document.getElementById(id);
            el.value = '';
            el.type = 'password';
            el.style.borderColor = '';
        });
        [['eyeOld','eyeOffOld'],['eyeNew','eyeOffNew'],['eyeConfirm','eyeOffConfirm']].forEach(([on, off]) => {
            document.getElementById(on).style.display = 'inline';
            document.getElementById(off).style.display = 'none';
        });
        ['errOldPw','errNewPw','errConfirmPw'].forEach(id => document.getElementById(id).textContent = '');
        document.getElementById('changePwModal').classList.add('open');
    }
    function closeChangePwModal() {
        document.getElementById('changePwModal').classList.remove('open');
    }
    function closeOnOverlayPw(e) {
        if (e.target === document.getElementById('changePwModal')) closeChangePwModal();
    }

    function togglePw(inputId, eyeId, eyeOffId) {
        const input = document.getElementById(inputId);
        const eye = document.getElementById(eyeId);
        const eyeOff = document.getElementById(eyeOffId);
        if (input.type === 'password') {
            input.type = 'text';
            eye.style.display = 'none';
            eyeOff.style.display = 'inline';
        } else {
            input.type = 'password';
            eye.style.display = 'inline';
            eyeOff.style.display = 'none';
        }
    }

    function setPwError(inputId, errId, msg) {
        const el = document.getElementById(inputId);
        el.style.borderColor = msg ? '#ef4444' : '';
        document.getElementById(errId).textContent = msg;
    }

    function validatePwForm() {
        let valid = true;
        const oldPw = document.getElementById('oldPassword').value;
        const newPw = document.getElementById('newPassword').value;
        const confirmPw = document.getElementById('confirmPassword').value;

        if (!oldPw) {
            setPwError('oldPassword', 'errOldPw', 'Vui lòng nhập mật khẩu cũ.');
            valid = false;
        } else {
            setPwError('oldPassword', 'errOldPw', '');
        }

        if (newPw.length < 6) {
            setPwError('newPassword', 'errNewPw', 'Mật khẩu mới phải có ít nhất 6 ký tự.');
            valid = false;
        } else {
            setPwError('newPassword', 'errNewPw', '');
        }

        if (confirmPw && newPw !== confirmPw) {
            setPwError('confirmPassword', 'errConfirmPw', 'Mật khẩu xác nhận không khớp.');
            valid = false;
        } else if (confirmPw) {
            setPwError('confirmPassword', 'errConfirmPw', '');
        }

        return valid;
    }

    // Inline validation on input
    document.getElementById('oldPassword')?.addEventListener('input', function() {
        setPwError('oldPassword', 'errOldPw', this.value ? '' : 'Vui lòng nhập mật khẩu cũ.');
    });
    document.getElementById('newPassword')?.addEventListener('input', function() {
        setPwError('newPassword', 'errNewPw', this.value.length >= 6 ? '' : 'Mật khẩu mới phải có ít nhất 6 ký tự.');
        // re-check confirm
        const confirmPw = document.getElementById('confirmPassword').value;
        if (confirmPw) {
            setPwError('confirmPassword', 'errConfirmPw', this.value === confirmPw ? '' : 'Mật khẩu xác nhận không khớp.');
        }
    });
    document.getElementById('confirmPassword')?.addEventListener('input', function() {
        const newPw = document.getElementById('newPassword').value;
        setPwError('confirmPassword', 'errConfirmPw', this.value === newPw ? '' : 'Mật khẩu xác nhận không khớp.');
    });
</script>
