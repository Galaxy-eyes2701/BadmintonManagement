@{
    ViewData["Title"] = "Lịch sử hoạt động";
    Layout = "_UserLayout";
}

@{
    var tab = ViewBag.Tab ?? "bookings";
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var totalCount = ViewBag.TotalCount ?? 0;
}

<style>
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.5);
        z-index: 1050;
        align-items: center;
        justify-content: center;
    }
    .modal-overlay.open { display: flex; }
    .detail-modal-box {
        background: white;
        border-radius: 16px;
        width: 90%;
        max-width: 520px;
        max-height: 85vh;
        overflow-y: auto;
        box-shadow: 0 20px 60px rgba(0,0,0,.25);
        animation: modalIn .2s ease;
    }
    @@keyframes modalIn {
        from { opacity: 0; transform: translateY(-16px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .detail-modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 24px;
        border-bottom: 1px solid #e2e8f0;
    }
    .detail-modal-title { margin: 0; font-size: 1rem; font-weight: 800; color: #0f172a; }
    .detail-modal-close {
        background: none; border: none; font-size: 1.2rem;
        cursor: pointer; color: #64748b; padding: 4px 8px; border-radius: 6px;
    }
    .detail-modal-close:hover { background: #f1f5f9; }
    .detail-modal-body { padding: 20px 24px; }
    .detail-row {
        display: flex; justify-content: space-between;
        padding: 10px 0; border-bottom: 1px solid #f1f5f9; font-size: .9rem;
    }
    .detail-row:last-child { border-bottom: none; }
    .detail-label { color: #64748b; font-weight: 600; }
    .detail-value { color: #0f172a; font-weight: 700; text-align: right; }
    .detail-section { margin-top: 16px; }
    .detail-section-title { font-weight: 800; color: #0f172a; margin-bottom: 10px; font-size: .9rem; }
    .detail-slot-row {
        background: #f8fafc; border-radius: 10px; padding: 12px;
        margin-bottom: 8px; font-size: .85rem;
    }
    .detail-slot-right { display: flex; justify-content: space-between; margin-top: 4px; color: #64748b; }
    .detail-slot-price { font-weight: 700; color: #0f766e; }
    .btn-cancel-modal {
        width: 100%; margin-top: 16px; padding: 10px;
        background: #fef2f2; border: 1.5px solid #fca5a5; color: #991b1b;
        border-radius: 10px; font-weight: 700; cursor: pointer; font-size: .88rem;
    }
    .btn-cancel-modal:hover { background: #fee2e2; }
    .modal-loading { text-align: center; padding: 32px; color: #64748b; }
</style>

<div class="history-page">
    <div class="page-header">
        <h1 class="page-title">📋 Lịch sử hoạt động</h1>
    </div>

    <div class="tab-bar">
        <a href="/User/History?tab=bookings" class="tab-btn @(tab == "bookings" ? "tab-active" : "")">
            🏸 Lịch sử đặt sân
        </a>
        <a href="/User/History?tab=orders" class="tab-btn @(tab == "orders" ? "tab-active" : "")">
            🛍️ Lịch sử mua hàng
        </a>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">⚠️ @ViewBag.Error</div>
    }

    @if (tab == "bookings")
    {
        <div class="list-wrap">
            @if (!(ViewBag.Bookings is JsonElement bookingsEl && bookingsEl.ValueKind == JsonValueKind.Array && bookingsEl.EnumerateArray().Any()))
            {
                <div class="empty-state">
                    <span class="empty-icon">🏸</span>
                    <p>Bạn chưa có lịch đặt sân nào.</p>
                    <p class="empty-hint">Đặt ngay để bắt đầu!</p>
                </div>
            }
            else
            {
                @foreach (var b in bookingsEl.EnumerateArray())
                {
                    var bookingId = b.TryGetProperty("bookingId", out var bidEl) ? bidEl.GetInt32() :
                                    b.TryGetProperty("BookingId", out bidEl) ? bidEl.GetInt32() : 0;
                    var status = b.TryGetProperty("status", out var stEl) ? stEl.GetString() :
                                 b.TryGetProperty("Status", out stEl) ? stEl.GetString() : "pending";
                    var paymentStatus = b.TryGetProperty("paymentStatus", out JsonElement psEl) ? psEl.GetString() :
                                        b.TryGetProperty("PaymentStatus", out psEl) ? psEl.GetString() : "none";
                    var totalPrice = b.TryGetProperty("totalPrice", out var tpEl) ? tpEl.GetDecimal() :
                                     b.TryGetProperty("TotalPrice", out tpEl) ? tpEl.GetDecimal() : 0m;
                    var firstCourtName = b.TryGetProperty("firstCourtName", out var fcEl) ? fcEl.GetString() :
                                         b.TryGetProperty("FirstCourtName", out fcEl) ? fcEl.GetString() : "—";
                    var firstBranchName = b.TryGetProperty("firstBranchName", out var fbEl) ? fbEl.GetString() :
                                          b.TryGetProperty("FirstBranchName", out fbEl) ? fbEl.GetString() : "—";
                    var firstPlayDate = b.TryGetProperty("firstPlayDate", out var fpEl) ? fpEl.GetString() :
                                        b.TryGetProperty("FirstPlayDate", out fpEl) ? fpEl.GetString() : "—";
                    var slotCount = b.TryGetProperty("slotCount", out var scEl) ? scEl.GetInt32() :
                                    b.TryGetProperty("SlotCount", out scEl) ? scEl.GetInt32() : 1;
                    var createdAt = b.TryGetProperty("createdAt", out var caEl) ? caEl.GetDateTime() :
                                    b.TryGetProperty("CreatedAt", out caEl) ? caEl.GetDateTime() : DateTime.Now;

                    var statusLabel = status switch
                    {
                        "pending" => ("Chờ xác nhận", "🕐", "status-pending"),
                        "confirmed" => ("Đã xác nhận", "✅", "status-confirmed"),
                        "completed" => ("Hoàn thành", "🏆", "status-completed"),
                        "cancelled" => ("Đã hủy", "❌", "status-cancelled"),
                        _ => (status, "❓", "status-pending")
                    };

                    var payLabel = paymentStatus switch
                    {
                        "pending" => "Chưa thanh toán",
                        "success" => "Đã thanh toán",
                        "cancelled" => "Đã hủy TT",
                        _ => "—"
                    };

                    <div class="booking-card" data-booking-id="@bookingId">
                        <div class="booking-card-left">
                            <div class="booking-info">
                                <h3 class="booking-court">@firstCourtName</h3>
                                <p class="booking-meta">📍 @firstBranchName</p>
                                <p class="booking-meta">📅 @firstPlayDate @(slotCount > 1 ? $"· +{slotCount - 1} ca khác" : "")</p>
                                <p class="booking-meta">🕐 @createdAt.ToString("dd/MM/yyyy HH:mm")</p>
                            </div>
                        </div>
                        <div class="booking-card-right">
                            <span class="status-badge @statusLabel.Item3">@statusLabel.Item2 @statusLabel.Item1</span>
                            <span class="pay-badge">💳 @payLabel</span>
                            <div class="booking-price">@totalPrice.ToString("N0")đ</div>
                            <div class="booking-actions">
                                @if (status == "pending" && paymentStatus != "success")
                                {
                                    <button class="btn-pay" onclick="payDeposit(@bookingId, @totalPrice)">💳 Đặt cọc</button>
                                }
                                <button class="btn-detail" onclick="viewDetail(@bookingId)">Chi tiết</button>
                                @if ((status == "pending" || status == "confirmed") && paymentStatus != "success")
                                {
                                    <button class="btn-cancel" onclick="cancelBooking(@bookingId)">Hủy</button>
                                }
                            </div>
                        </div>
                    </div>
                }
                
                <!-- Pagination -->
                @if (totalPages > 1)
                {
                    <div class="pagination">
                        <span class="pagination-info">Hiển thị @((currentPage - 1) * 5 + 1)-@Math.Min(currentPage * 5, totalCount) của @totalCount kết quả</span>
                        <div class="pagination-controls">
                            @if (currentPage > 1)
                            {
                                <a href="/User/History?tab=bookings&page=@(currentPage - 1)" class="pagination-btn">← Trước</a>
                            }
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                if (i == currentPage)
                                {
                                    <span class="pagination-btn pagination-active">@i</span>
                                }
                                else if (i == 1 || i == totalPages || (i >= currentPage - 1 && i <= currentPage + 1))
                                {
                                    <a href="/User/History?tab=bookings&page=@i" class="pagination-btn">@i</a>
                                }
                                else if (i == currentPage - 2 || i == currentPage + 2)
                                {
                                    <span class="pagination-dots">...</span>
                                }
                            }
                            @if (currentPage < totalPages)
                            {
                                <a href="/User/History?tab=bookings&page=@(currentPage + 1)" class="pagination-btn">Sau →</a>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    }
    else
    {
        <div class="list-wrap">
            @if (!(ViewBag.Orders is JsonElement ordersEl && ordersEl.ValueKind == JsonValueKind.Array && ordersEl.EnumerateArray().Any()))
            {
                <div class="empty-state">
                    <span class="empty-icon">🛍️</span>
                    <p>Chưa có đơn hàng nào.</p>
                </div>
            }
            else
            {
                @foreach (var o in ordersEl.EnumerateArray())
                {
                    var orderId = o.TryGetProperty("orderId", out var oidEl) ? oidEl.GetInt32() :
                                  o.TryGetProperty("OrderId", out oidEl) ? oidEl.GetInt32() : 0;
                    var orderTotal = o.TryGetProperty("totalAmount", out var otEl) ? otEl.GetDecimal() :
                                     o.TryGetProperty("TotalAmount", out otEl) ? otEl.GetDecimal() : 0m;
                    var orderDate = o.TryGetProperty("createdAt", out var odEl) ? odEl.GetDateTime() :
                                    o.TryGetProperty("CreatedAt", out odEl) ? odEl.GetDateTime() : DateTime.Now;
                    var orderBookingId = o.TryGetProperty("bookingId", out JsonElement obEl) ? obEl.GetInt32() :
                                         o.TryGetProperty("BookingId", out obEl) ? obEl.GetInt32() : 0;
                    var items = o.TryGetProperty("items", out JsonElement itemsEl) ? itemsEl.EnumerateArray().ToList() :
                                o.TryGetProperty("Items", out itemsEl) ? itemsEl.EnumerateArray().ToList() : new List<JsonElement>();

                    <div class="order-card">
                        <div class="order-header">
                            <div>
                                <span class="order-id">Đơn hàng</span>
                            </div>
                            <span class="order-date">@orderDate.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="order-items">
                            @foreach (var item in items)
                            {
                                var productName = item.TryGetProperty("productName", out var pnEl) ? pnEl.GetString() :
                                                  item.TryGetProperty("ProductName", out pnEl) ? pnEl.GetString() : "—";
                                var category = item.TryGetProperty("category", out var catEl) ? catEl.GetString() :
                                               item.TryGetProperty("Category", out catEl) ? catEl.GetString() : "—";
                                var qty = item.TryGetProperty("quantity", out var qEl) ? qEl.GetInt32() :
                                          item.TryGetProperty("Quantity", out qEl) ? qEl.GetInt32() : 0;
                                var subTotal = item.TryGetProperty("subTotal", out var stEl2) ? stEl2.GetDecimal() :
                                               item.TryGetProperty("SubTotal", out stEl2) ? stEl2.GetDecimal() : 0m;
                                <div class="order-item">
                                    <div class="order-item-info">
                                        <span class="order-item-name">@productName</span>
                                        <span class="order-item-cat">@category</span>
                                    </div>
                                    <span class="order-item-qty">×@qty</span>
                                    <span class="order-item-price">@subTotal.ToString("N0")đ</span>
                                </div>
                            }
                        </div>
                        <div class="order-footer">
                            <span class="order-total">Tổng: <strong>@orderTotal.ToString("N0")đ</strong></span>
                            <span class="status-badge status-completed">✅ Đã mua</span>
                        </div>
                    </div>
                }
                
                <!-- Pagination -->
                @if (totalPages > 1)
                {
                    <div class="pagination">
                        <span class="pagination-info">Hiển thị @((currentPage - 1) * 5 + 1)-@Math.Min(currentPage * 5, totalCount) của @totalCount kết quả</span>
                        <div class="pagination-controls">
                            @if (currentPage > 1)
                            {
                                <a href="/User/History?tab=orders&page=@(currentPage - 1)" class="pagination-btn">← Trước</a>
                            }
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                if (i == currentPage)
                                {
                                    <span class="pagination-btn pagination-active">@i</span>
                                }
                                else if (i == 1 || i == totalPages || (i >= currentPage - 1 && i <= currentPage + 1))
                                {
                                    <a href="/User/History?tab=orders&page=@i" class="pagination-btn">@i</a>
                                }
                                else if (i == currentPage - 2 || i == currentPage + 2)
                                {
                                    <span class="pagination-dots">...</span>
                                }
                            }
                            @if (currentPage < totalPages)
                            {
                                <a href="/User/History?tab=orders&page=@(currentPage + 1)" class="pagination-btn">Sau →</a>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>

<!-- Detail Modal -->
<div class="modal-overlay" id="detailModal" onclick="closeModal()">
    <div class="detail-modal-box" onclick="event.stopPropagation()">
        <div class="detail-modal-header">
            <h3 class="detail-modal-title">📋 Chi tiết đặt sân</h3>
            <button class="detail-modal-close" onclick="closeModal()">✕</button>
        </div>
        <div class="detail-modal-body" id="modalBody">
        </div>
    </div>
</div>

@section Scripts {
<script>
    async function viewDetail(bookingId) {
        const modal = document.getElementById('detailModal');
        document.getElementById('modalBody').innerHTML = '<div class="modal-loading">⏳ Đang tải...</div>';
        modal.classList.add('open');

        try {
            const response = await fetch('/User/BookingDetail/' + bookingId);
            const data = await response.json();

            if (data.success) {
                const d = data.data;
                let html = `
                    <div class="detail-row">
                        <span class="detail-label">📊 Trạng thái</span>
                        <span class="detail-value">${d.status}</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">🕐 Thời gian đặt</span>
                        <span class="detail-value">${new Date(d.createdAt).toLocaleString('vi-VN')}</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">💰 Tổng tiền sân</span>
                        <span class="detail-value">${d.totalPrice?.toLocaleString('vi-VN')}đ</span>
                    </div>
                `;

                if (d.details && d.details.length > 0) {
                    html += '<div class="detail-section"><p class="detail-section-title">⏰ Chi tiết ca chơi:</p>';
                    d.details.forEach(slot => {
                        html += `
                            <div class="detail-slot-row">
                                <div><strong>${slot.courtName}</strong><small> · ${slot.branchName} · ${slot.courtType}</small></div>
                                <div class="detail-slot-right">
                                    <span>${slot.playDate} · ${slot.timeSlot}</span>
                                    <span class="detail-slot-price">${slot.price?.toLocaleString('vi-VN')}đ</span>
                                </div>
                            </div>
                        `;
                    });
                    html += '</div>';
                }

                if (d.canCancel) {
                    html += `<button class="btn-cancel-modal" onclick="cancelBooking(${d.bookingId})">🗑️ Hủy booking này</button>`;
                }

                document.getElementById('modalBody').innerHTML = html;
            } else {
                document.getElementById('modalBody').innerHTML = '<p style="color:red">Không thể tải chi tiết.</p>';
            }
        } catch (err) {
            document.getElementById('modalBody').innerHTML = '<p style="color:red">Lỗi: ' + err.message + '</p>';
        }
    }

    function closeModal() {
        document.getElementById('detailModal').classList.remove('open');
    }

    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

    async function payDeposit(bookingId, totalPrice) {
        if (!confirm('Bạn có muốn thanh toán đặt cọc 50% cho booking #' + bookingId + '?')) return;

        try {
            const formData = new FormData();
            formData.append('bookingId', bookingId);

            const response = await fetch('/User/CreateDepositPayment', {
                method: 'POST',
                body: formData
            });
            const data = await response.json();

            if (data.success && data.paymentUrl) {
                window.location.href = data.paymentUrl;
            } else {
                alert(data.message || 'Không thể tạo thanh toán');
            }
        } catch (err) {
            alert('Lỗi: ' + err.message);
        }
    }

    async function cancelBooking(bookingId) {
        if (!confirm('Bạn có chắc muốn hủy lịch đặt sân này không?')) return;

        try {
            const response = await fetch('/User/CancelBooking/' + bookingId, { method: 'POST' });
            const data = await response.json();

            if (data.success) {
                location.reload();
            } else {
                alert(data.message || 'Hủy thất bại');
            }
        } catch (err) {
            alert('Lỗi: ' + err.message);
        }
    }

</script>
}
