@{
    Layout = null;  /* <--- BẠN PHẢI THÊM DÒNG NÀY VÀO TRÊN CÙNG ĐỂ CHẶN VÒNG LẶP */
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Staff Panel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Nunito', sans-serif; background: #f1f5f9; min-height: 100vh; }

        /* ── HAMBURGER & OVERLAY ── */
        .sb-hamburger {
            font-size: 22px; background: linear-gradient(135deg, #0d5e58 0%, #0f766e 100%);
            border: none; color: white; cursor: pointer; position: fixed; top: 12px; left: 16px;
            z-index: 9999; width: 42px; height: 42px; border-radius: 10px; display: none;
            align-items: center; justify-content: center; box-shadow: 0 4px 15px rgba(15,118,110,.35); transition: all .3s ease;
        }
        .sb-overlay {
            position: fixed; inset: 0; background: rgba(0,0,0,.52); z-index: 997;
            backdrop-filter: blur(2px); opacity: 0; visibility: hidden; transition: all .35s ease;
        }

        /* ── SIDEBAR ── */
        .sb-sidebar {
            width: 280px; background: linear-gradient(160deg, #2d3748 0%, #1a202c 100%);
            color: white; z-index: 998; display: flex; flex-direction: column;
            border-right: 1px solid rgba(255,255,255,.08); position: sticky; top: 0;
            height: 100vh; overflow-y: auto; flex-shrink: 0; transition: left .4s cubic-bezier(.4,0,.2,1);
        }
        .sb-sidebar::before { content: ''; position: absolute; inset: 0; background: linear-gradient(135deg,rgba(15,118,110,.08) 0%,rgba(13,94,88,.08) 100%); pointer-events: none; }
        .sb-sidebar::-webkit-scrollbar { width: 5px; }
        .sb-sidebar::-webkit-scrollbar-track { background: rgba(255,255,255,.05); }
        .sb-sidebar::-webkit-scrollbar-thumb { background: linear-gradient(135deg,#14b8a6,#0f766e); border-radius: 3px; }

        .sb-header { background: linear-gradient(135deg, #0d5e58 0%, #0f766e 100%); padding: 22px; flex-shrink: 0; border-bottom: 1px solid rgba(255,255,255,.1); position: relative; }
        .sb-brand { display: flex; align-items: center; gap: 12px; }
        .sb-brand-icon { font-size: 26px; filter: drop-shadow(0 2px 6px rgba(0,0,0,.3)); }
        .sb-brand-name { font-size: 22px; font-weight: 900; margin: 0; background: linear-gradient(135deg,#fff,#f7fafc); -webkit-background-clip: text; -webkit-text-fill-color: transparent; line-height: 1.1; }
        .sb-brand-sub { font-size: 12px; color: #fed7aa; font-weight: 700; margin-top: 2px; }
        .sb-close-btn { display: none; }

        /* ── NAV MENU ── */
        .sb-nav { padding: 16px 0 0; flex: 1; position: relative; z-index: 1; }
        .sb-section-label { font-size: 11px; color: #94a3b8; text-transform: uppercase; letter-spacing: .08em; padding: 14px 26px 5px; font-weight: 800; }
        .sb-nav-item {
            display: flex; align-items: center; gap: 10px; padding: 13px 26px; color: #cbd5e1; font-size: 15px; font-weight: 600;
            text-decoration: none; border-left: 4px solid transparent; transition: all .3s ease; position: relative;
        }
        .sb-nav-item::before { content: '●'; font-size: 7px; color: rgba(255,255,255,.2); flex-shrink: 0; transition: all .3s ease; }
        .sb-nav-item:hover { background: linear-gradient(135deg,rgba(15,118,110,.12),rgba(13,94,88,.12)); border-left-color: #14b8a6; color: #fff; padding-left: 32px; }
        .sb-nav-item:hover::before { color: #14b8a6; transform: scale(1.3); }
        .sb-nav-item.active {
            background: linear-gradient(135deg,rgba(15,118,110,.22),rgba(13,94,88,.22)) !important;
            border-left-color: #fbbf24 !important; color: #fbbf24 !important; font-weight: 800 !important; padding-left: 32px;
        }
        .sb-nav-item.active::before { content: '♦' !important; color: #fbbf24 !important; font-size: 9px !important; }

        .sb-footer { padding: 12px 16px; border-top: 1px solid rgba(255,255,255,.08); position: relative; z-index: 1; }
        .sb-footer a { display: flex; align-items: center; gap: 10px; padding: 11px 18px; border-radius: 10px; color: #fca5a5; font-size: 14px; font-weight: 700; text-decoration: none; transition: all .2s; }
        .sb-footer a:hover { background: rgba(239,68,68,.12); color: #fef2f2; }

        /* ── MAIN CONTENT ── */
        .main-wrapper { flex: 1; min-width: 0; display: flex; flex-direction: column; min-height: 100vh; }
        .top-bar { background: white; border-bottom: 1px solid #e2e8f0; padding: 0 24px; height: 70px; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 995; box-shadow: 0 2px 10px rgba(0,0,0,.02); }
        .top-bar-title { font-size: 18px; font-weight: 800; color: #0f172a; margin: 0; }
        .staff-profile { display: flex; align-items: center; gap: 10px; background: #f8fafc; padding: 6px 14px; border-radius: 50px; border: 1px solid #e2e8f0; }
        .staff-avatar { width: 28px; height: 28px; background: #14b8a6; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 13px; }

        /* ── RESPONSIVE ── */
        @@media (max-width: 991.98px) {
            .sb-hamburger { display: flex; }
            .top-bar { padding-left: 70px; }
            .sb-close-btn { display: inline-block; font-size: 15px; color: white; background: rgba(255,255,255,.18); border: none; padding: 7px 12px; border-radius: 8px; margin-bottom: 12px; }
            .sb-sidebar { position: fixed; left: -320px; }
            .sb-sidebar.open { left: 0; box-shadow: 4px 0 30px rgba(0,0,0,.4); }
            .sb-overlay.visible { opacity: 1; visibility: visible; }
        }
    </style>
</head>
<body class="d-flex">

    <button class="sb-hamburger" id="sbHamburger" onclick="openSidebar()" title="Mở menu">&#9776;</button>

    <div class="sb-overlay" id="sbOverlay" onclick="closeSidebar()"></div>

    <aside class="sb-sidebar" id="sbSidebar">
        <div class="sb-header">
            <button class="sb-close-btn" onclick="closeSidebar()">&#171;&#171;</button>
            <div class="sb-brand">
                <span class="sb-brand-icon">🏸</span>
                <div>
                    <p class="sb-brand-name">Badminton</p>
                    <p class="sb-brand-sub">STAFF PANEL</p>
                </div>
            </div>
        </div>

        <nav class="sb-nav">
            <div class="sb-section-label">Lịch đặt sân</div>
            <a href="/Staff/Schedule" class="sb-nav-item @(ViewData["Page"]?.ToString() == "schedule" ? "active" : "")">📅 Lịch sân hôm nay</a>
            <a href="/Staff/Bookings" class="sb-nav-item @(ViewData["Page"]?.ToString() == "bookings" ? "active" : "")">📋 Quản lý Booking</a>
            <a href="/Staff/FixedSchedule" class="sb-nav-item @(ViewData["Page"]?.ToString() == "fixed" ? "active" : "")">🔁 Lịch cố định</a>

            <div class="sb-section-label mt-2">Bán hàng & Dịch vụ</div>
            <a href="/Staff/Pos" class="sb-nav-item @(ViewData["Page"]?.ToString() == "pos" ? "active" : "")">🛒 Máy POS Bán hàng</a>
            <a href="/Staff/Products" class="sb-nav-item @(ViewData["Page"]?.ToString() == "products" ? "active" : "")">📦 Quản lý kho nước</a>
        </nav>

        <div class="sb-footer">
            <a href="/Auth/Logout">🚪 Đăng xuất</a>
        </div>
    </aside>

    <div class="main-wrapper">
        <header class="top-bar">
            <h1 class="top-bar-title">@ViewData["Title"]</h1>
            <div class="staff-profile">
                <div class="staff-avatar">
                    @(Context.Session.GetString("UserName")?.FirstOrDefault() ?? 'S')
                </div>
                <span class="fw-bold text-secondary" style="font-size: 14px;">
                    @Context.Session.GetString("UserName")
                </span>
            </div>
        </header>

        <div class="flex-grow-1 p-0 m-0 w-100">
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function openSidebar() { document.getElementById('sbSidebar').classList.add('open'); document.getElementById('sbOverlay').classList.add('visible'); document.getElementById('sbHamburger').style.display = 'none'; }
        function closeSidebar() { document.getElementById('sbSidebar').classList.remove('open'); document.getElementById('sbOverlay').classList.remove('visible'); setTimeout(() => { document.getElementById('sbHamburger').style.display = 'flex'; }, 300); }
        document.addEventListener('keydown', e => { if(e.key === 'Escape') closeSidebar(); });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>