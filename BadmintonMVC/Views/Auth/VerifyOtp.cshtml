@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Xác nhận OTP</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
    <style>
        body {
            font-family: 'Nunito', sans-serif;
            background: linear-gradient(135deg, #0d5e58, #0f766e, #14b8a6);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .card { border-radius: 16px; border: none; box-shadow: 0 20px 60px rgba(0,0,0,.2); }
        .btn-primary { background: linear-gradient(135deg, #0f766e, #14b8a6); border: none; font-weight: 700; }
        .btn-primary:hover { background: linear-gradient(135deg, #0d5e58, #0f766e); }
        .form-control:focus { border-color: #14b8a6; box-shadow: 0 0 0 3px rgba(20,184,166,.15); }
        .otp-input {
            font-size: 1.6rem;
            font-weight: 900;
            letter-spacing: 8px;
            text-align: center;
            color: #0f766e;
        }
        .email-badge {
            background: #ecfdf5;
            border: 1px solid #6ee7b7;
            color: #065f46;
            border-radius: 8px;
            padding: 8px 14px;
            font-size: .85rem;
            font-weight: 700;
            text-align: center;
            margin-bottom: 20px;
        }
        .password-wrapper { position: relative; }
        .password-toggle {
            position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
            background: none; border: none; color: #64748b; cursor: pointer;
            font-size: 1.1rem; padding: 0; width: 32px; height: 32px;
            display: flex; align-items: center; justify-content: center;
        }
        .password-toggle:hover { color: #0f766e; }
        .step-indicator {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin-bottom: 20px;
        }
        .step { width: 32px; height: 4px; border-radius: 2px; background: #e2e8f0; }
        .step.done { background: #14b8a6; }
    </style>
</head>
<body>
    <div class="card p-4" style="width:440px">
        <div class="text-center mb-3">
            <span style="font-size:48px">📧</span>
            <h4 class="fw-black mt-2 mb-0" style="color:#0f766e">Xác nhận OTP</h4>
            <p class="text-muted small">Nhập mã OTP đã gửi đến email của bạn</p>
        </div>

        <div class="step-indicator">
            <div class="step done"></div>
            <div class="step done"></div>
            <div class="step"></div>
        </div>

        <div class="email-badge">📬 @ViewBag.OtpEmail</div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2 small">⚠️ @ViewBag.Error</div>
        }

        <form method="post">
            <input type="hidden" name="email" value="@ViewBag.OtpEmail" />

            <div class="mb-3">
                <label class="form-label fw-semibold">Mã OTP (6 số)</label>
                <input type="text" name="otp" class="form-control otp-input"
                       placeholder="000000" maxlength="6" pattern="\d{6}"
                       inputmode="numeric" required autofocus />
                <div class="form-text">Mã có hiệu lực trong 10 phút</div>
            </div>

            <hr class="my-3" />

            <div class="mb-3">
                <label class="form-label fw-semibold">Mật khẩu mới</label>
                <div class="password-wrapper">
                    <input type="password" name="newPassword" id="newPassword" class="form-control"
                           placeholder="••••••••" required minlength="6" />
                    <button type="button" class="password-toggle" onclick="togglePwd('newPassword', this)">👁️</button>
                </div>
            </div>
            <div class="mb-4">
                <label class="form-label fw-semibold">Xác nhận mật khẩu</label>
                <div class="password-wrapper">
                    <input type="password" name="confirmPassword" id="confirmPassword" class="form-control"
                           placeholder="••••••••" required minlength="6" />
                    <button type="button" class="password-toggle" onclick="togglePwd('confirmPassword', this)">👁️</button>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2">Đặt lại mật khẩu</button>
        </form>

        <hr class="my-3" />
        <p class="text-center text-muted small mb-0">
            Không nhận được mã?
            <a href="/Auth/ForgotPassword" style="color:#0f766e;font-weight:600">Gửi lại</a>
            &nbsp;·&nbsp;
            <a href="/Auth/Login" style="color:#0f766e;font-weight:600">Đăng nhập</a>
        </p>
    </div>

    <script>
        function togglePwd(id, btn) {
            const input = document.getElementById(id);
            if (input.type === 'password') { input.type = 'text'; btn.textContent = '🙈'; }
            else { input.type = 'password'; btn.textContent = '👁️'; }
        }
    </script>
</body>
</html>
