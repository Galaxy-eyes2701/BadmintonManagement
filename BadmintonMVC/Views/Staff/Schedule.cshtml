@using System.Security.Claims
@{
    ViewData["Title"] = "Lịch Sân Hôm Nay";
    ViewData["Page"] = "schedule";
    Layout = "_StaffLayout"; // Gọi Layout vào đây!

    var jwtToken = User.FindFirst("Token")?.Value
                   ?? Context.Session.GetString("AuthToken") // Đã dùng đúng AuthToken
                   ?? "";
}
<style>
    /* ── MODERN SCHEDULE UI ── */
    .sch-container { padding: 24px; background: #f1f5f9; min-height: calc(100vh - 70px); font-family: 'Nunito', sans-serif; }
    .sch-toolbar { display: flex; align-items: center; justify-content: space-between; background: white; padding: 16px 24px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,.03); margin-bottom: 24px; flex-wrap: wrap; gap: 16px; border: 1px solid #e2e8f0; }
    .sch-controls { display: flex; align-items: center; gap: 12px; }
    .sch-date-input { border: 2px solid #e2e8f0; border-radius: 10px; padding: 8px 16px; font-weight: 700; color: #0f172a; outline: none; transition: all .2s; }
    .sch-date-input:focus { border-color: #14b8a6; box-shadow: 0 0 0 3px rgba(20,184,166,.15); }
    .btn-sch { padding: 8px 16px; border-radius: 10px; font-weight: 700; border: none; cursor: pointer; transition: all .2s; display: flex; align-items: center; gap: 6px; }
    .btn-sch-today { background: #eff6ff; color: #3b82f6; }
    .btn-sch-today:hover { background: #dbeafe; transform: translateY(-1px); }
    .btn-sch-now { background: #fff7ed; color: #f97316; }
    .btn-sch-now:hover { background: #ffedd5; transform: translateY(-1px); }
    .sch-legend { display: flex; gap: 16px; font-size: 13px; font-weight: 700; color: #64748b; }
    .legend-item { display: flex; align-items: center; gap: 6px; }
    .legend-dot { width: 12px; height: 12px; border-radius: 4px; }
    .ot-alert { display: none; background: linear-gradient(135deg, #fef2f2, #fee2e2); border-left: 6px solid #ef4444; padding: 16px 24px; border-radius: 12px; margin-bottom: 24px; box-shadow: 0 4px 15px rgba(239, 68, 68, .1); align-items: center; gap: 16px; animation: slideIn .3s ease-out; }
    .ot-alert.show { display: flex; }
    .ot-icon { font-size: 32px; animation: pulseOT 1.5s infinite; }
    .sch-grid-card { background: white; border-radius: 20px; box-shadow: 0 4px 25px rgba(0,0,0,.04); overflow: hidden; border: 1px solid #e2e8f0; }
    .sch-grid-scroll { overflow-x: auto; overflow-y: auto; max-height: calc(100vh - 280px); }
    table.sch-table { width: 100%; border-collapse: separate; border-spacing: 0; min-width: 800px; }
    .sch-table thead th { position: sticky; top: 0; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); z-index: 20; padding: 16px; font-weight: 800; color: #0f172a; border-bottom: 2px solid #e2e8f0; text-align: center; font-size: 15px; }
    .sch-table thead th:first-child { left: 0; z-index: 21; background: #f8fafc; border-right: 2px solid #e2e8f0; }
    .sch-table tbody td { padding: 10px; border-bottom: 1px dashed #e2e8f0; border-right: 1px dashed #e2e8f0; vertical-align: middle; }
    .sch-table tbody td:last-child { border-right: none; }
    .sch-time-cell { position: sticky; left: 0; background: #f8fafc; border-right: 2px solid #e2e8f0 !important; z-index: 10; text-align: center; padding: 12px !important; width: 120px; }
    .time-start { font-size: 17px; font-weight: 900; color: #1e293b; }
    .time-end { font-size: 12px; font-weight: 700; color: #94a3b8; }
    .time-now-badge { background: #f97316; color: white; font-size: 10px; font-weight: 800; padding: 3px 10px; border-radius: 12px; display: inline-block; margin-bottom: 4px; animation: pulseOT 2s infinite; text-transform: uppercase; letter-spacing: 0.5px; }
    .row-now > td:not(.sch-time-cell) { background: rgba(249, 115, 22, 0.03); }
    
    /* ── STYLING CHO NÚT CỘNG (SÂN TRỐNG) ── */
    .slot-empty { height: 84px; border-radius: 14px; background: #f8fafc; border: 2px dashed #e2e8f0; display: flex; align-items: center; justify-content: center; color: #cbd5e1; font-size: 24px; transition: all .2s; cursor: pointer; }
    .slot-empty:hover { background: #f0fdf4; border-color: #22c55e; color: #22c55e; transform: scale(0.98); }
    
    .slot-maint { height: 84px; border-radius: 14px; background: #fefce8; border: 2px solid #fef08a; display: flex; align-items: center; justify-content: center; color: #a16207; font-weight: 700; }
    .slot-book { height: 84px; border-radius: 14px; padding: 12px 16px; cursor: pointer; display: flex; flex-direction: column; justify-content: center; transition: all .2s; position: relative; overflow: hidden; }
    .slot-book:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(0,0,0,.08); }
    .s-name { font-weight: 800; font-size: 14px; color: #0f172a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .s-phone { font-size: 12px; color: #64748b; font-weight: 700; margin-top: 3px; }
    .state-waiting { background: #eff6ff; border-left: 5px solid #3b82f6; }
    .state-waiting .s-badge { background: #dbeafe; color: #2563eb; }
    .state-active { background: linear-gradient(135deg, #fff7ed, #ffedd5); border-left: 5px solid #f97316; box-shadow: inset 0 0 0 1px rgba(249,115,22,.15); }
    .state-active .s-badge { background: #f97316; color: white; }
    .state-overtime { background: linear-gradient(135deg, #fef2f2, #fee2e2); border-left: 5px solid #ef4444; animation: flashOT 2s infinite; }
    .state-overtime .s-badge { background: #ef4444; color: white; font-weight: 800; }
    .state-done { background: #f0fdf4; border-left: 5px solid #22c55e; opacity: 0.7; cursor: default; }
    .state-done:hover { transform: none; box-shadow: none; }
    .state-done .s-badge { background: #dcfce7; color: #16a34a; }
    .s-badge { position: absolute; top: 12px; right: 12px; font-size: 10px; font-weight: 800; padding: 3px 8px; border-radius: 8px; text-transform: uppercase; }
    
    @@keyframes pulseOT { 0%,100% { opacity: 1; } 50% { opacity: 0.5; } }
    @@keyframes flashOT { 0%,100% { box-shadow: 0 0 0 0 rgba(239,68,68,0); } 50% { box-shadow: inset 0 0 0 2px rgba(239,68,68,.3); } }
    @@keyframes slideIn { from { transform: translateY(-10px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
    
    .loader-box { padding: 80px; text-align: center; color: #94a3b8; }
    .loader-shuttle { font-size: 48px; animation: bounce 0.8s infinite alternate; margin-bottom: 16px; }
    @@keyframes bounce { from { transform: translateY(0); } to { transform: translateY(-20px); } }
    .sch-grid-scroll::-webkit-scrollbar { width: 8px; height: 8px; }
    .sch-grid-scroll::-webkit-scrollbar-track { background: #f1f5f9; border-radius: 4px; }
    .sch-grid-scroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
    
    .modal-content { border-radius: 20px; border: none; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25); }
    .modal-header.bill-head { background: linear-gradient(135deg, #0d5e58, #0f766e); color: white; padding: 20px 24px; border: none; }
    .modal-title { font-weight: 800; font-size: 18px; }
    .btn-close-white { filter: brightness(0) invert(1); opacity: 0.8; }
    .bill-row { display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px dashed #e2e8f0; font-size: 15px; font-weight: 700; color: #334155; }
    .bill-total-row { display: flex; justify-content: space-between; padding: 16px 0 0; margin-top: 8px; border-top: 2px dashed #94a3b8; font-size: 20px; font-weight: 900; color: #0f172a;}
    .btn-ext { display: flex; justify-content: space-between; align-items: center; width: 100%; padding: 14px 18px; background: #f8fafc; border: 2px solid #e2e8f0; border-radius: 14px; margin-bottom: 10px; transition: all .2s; cursor: pointer; }
    .btn-ext:hover { border-color: #14b8a6; background: #f0fdfa; transform: translateX(5px); }
    .btn-ext-time { font-weight: 800; color: #0f172a; font-size: 15px; }
    .btn-ext-add { color: #0f766e; font-weight: 800; font-size: 13px; background: rgba(20,184,166,.15); padding: 5px 12px; border-radius: 8px; }
</style>

<div class="sch-container">
    <div class="sch-toolbar">
        <div class="sch-controls">
            <input type="date" id="datePick" class="sch-date-input" />
            <button class="btn-sch btn-sch-today" onclick="goToday()">
                <span style="font-size:16px">📅</span> Hôm nay
            </button>
            <button class="btn-sch btn-sch-now" onclick="scrollNow()">
                <span style="font-size:16px">🎯</span> Hiện tại
            </button>
            <span id="statusTxt" class="text-muted small fw-bold ms-2"></span>
        </div>

        <div class="sch-legend">
            <div class="legend-item"><div class="legend-dot" style="background:#3b82f6"></div>Chờ đánh</div>
            <div class="legend-item"><div class="legend-dot" style="background:#f97316"></div>Đang đánh</div>
            <div class="legend-item"><div class="legend-dot" style="background:#ef4444"></div>Quá giờ</div>
            <div class="legend-item"><div class="legend-dot" style="background:#22c55e"></div>Đã xong</div>
        </div>
    </div>

    <div class="ot-alert" id="otBanner">
        <div class="ot-icon">🚨</div>
        <div>
            <h5 class="fw-bold text-danger mb-1" style="font-size:16px">Cảnh báo: Có khách đang quá giờ!</h5>
            <div class="text-danger fw-bold" style="font-size:13px" id="otNames"></div>
        </div>
    </div>

    <div class="sch-grid-card">
        <div class="sch-grid-scroll" id="gridScroll">
            <div id="loadBox" class="loader-box">
                <div class="loader-shuttle">🏸</div>
                <div class="fw-bold fs-5 text-slate-700">Đang đồng bộ dữ liệu sân...</div>
                <div class="small mt-2">Vui lòng chờ trong giây lát</div>
            </div>

            <table class="sch-table" id="schedTbl" style="display:none">
                <thead><tr id="schedHead"></tr></thead>
                <tbody id="schedBody"></tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="billModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width:480px">
        <div class="modal-content">
            <div class="modal-header bill-head">
                <h5 class="modal-title" id="billTitle">💰 Tất toán hóa đơn</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4" id="billBody">
                <div class="text-center py-4"><div class="spinner-border text-teal"></div></div>
            </div>
            <div class="modal-footer border-0 pt-0 px-4 pb-4" id="billFoot" style="display:none; flex-wrap:nowrap; gap:8px">
                <button class="btn btn-light fw-bold" data-bs-dismiss="modal" style="width:100px">Đóng</button>
                <button class="btn fw-bold text-white" style="background:#f59e0b" onclick="openExtend()">⏰ Gia hạn</button>
                <button class="btn btn-success fw-bold flex-grow-1" onclick="doCheckout('Chuyển khoản')">📱 Mã QR</button>
                <button class="btn btn-dark fw-bold flex-grow-1" onclick="doCheckout('Tiền mặt')">💵 Tiền mặt</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="extModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0 mt-2 mx-2">
                <h5 class="modal-title fw-bold text-teal">⏰ Gia hạn thêm ca</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body px-4">
                <div class="mb-4">
                    <div class="text-muted small fw-bold">Khách hàng</div>
                    <div class="fw-black fs-6" id="extCustName"></div>
                    <div class="text-muted small fw-bold mt-2">Tại sân</div>
                    <div class="fw-black fs-6 text-teal" id="extCourtName"></div>
                </div>
                <div id="extSlotList">
                    <div class="text-center py-3"><div class="spinner-border spinner-border-sm text-secondary"></div></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="walkInModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold"><i class="fas fa-bolt"></i> Khách Vào Sân Trực Tiếp</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="walkInCourtId">
                <input type="hidden" id="walkInTimeSlotId">
                <input type="hidden" id="walkInDate">

                <div class="alert alert-info py-2 small border-0 bg-light shadow-sm">
                    <span class="text-muted fw-bold d-block mb-1">Đang xếp sân:</span>
                    <strong id="walkInCourtName" class="text-success fs-5"></strong> <br/>
                    <span class="text-muted fw-bold d-block mt-2 mb-1">Ca đánh:</span>
                    <strong id="walkInTime" class="text-success fs-5"></strong>
                </div>

                <div class="mb-3 mt-4">
                    <label class="form-label small fw-bold text-secondary">Chọn Khách Hàng</label>
                    <select id="walkInUserId" class="form-select form-select-lg fw-bold shadow-sm" style="cursor: pointer;">
                        <option value="">Khách Vãng Lai (Không cần tài khoản)</option>
                        </select>
                </div>
                
            </div>
            <div class="modal-footer bg-light border-top-0 pt-2 pb-3 px-3">
                <button type="button" class="btn btn-light fw-bold px-4" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" class="btn btn-success fw-bold px-4" id="btnSubmitWalkIn" onclick="submitWalkInBooking()">
                    <i class="fas fa-check"></i> Tạo Lịch Đánh Ngay
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API = 'http://localhost:5043/api';
        const TOKEN = '@jwtToken';
        const H = { 'Authorization': 'Bearer ' + TOKEN };
        const HJ = { 'Authorization': 'Bearer ' + TOKEN, 'Content-Type': 'application/json' };

        let schedData = [];
        let customerList = []; // Lưu danh sách Dropdown khách hàng
        let curBid = null, curBill = null, curCourtId = null, curCourtName = '', curSlotEnd = '', curCustName = '';
        let isToday = false;

        const dp = document.getElementById('datePick');
        dp.value = todayStr();
        dp.addEventListener('change', loadSched);
        
        // Khởi động
        loadCustomersForDropdown();
        loadSched();

        function todayStr() { return new Date().toISOString().split('T')[0]; }
        function goToday() { dp.value = todayStr(); loadSched(); }

        // ==========================================
        // FETCH DATA
        // ==========================================
        async function loadCustomersForDropdown() {
            try {
                const res = await fetch(`${API}/staff/setup-data`, { headers: H });
                if (res.ok) {
                    const data = await res.json();
                    customerList = data.customers || [];
                }
            } catch (err) { console.error("Lỗi tải danh sách khách hàng:", err); }
        }

        async function loadSched() {
            document.getElementById('loadBox').style.display = '';
            document.getElementById('schedTbl').style.display = 'none';
            document.getElementById('statusTxt').textContent = 'Đang tải...';
            document.getElementById('otBanner').classList.remove('show');

            isToday = (dp.value === todayStr());

            try {
                const res = await fetch(API + '/staff/daily-schedule?date=' + dp.value, { headers: H });
                schedData = await res.json();
                renderGrid();
                document.getElementById('statusTxt').textContent = 'Đã đồng bộ ✓';
                setTimeout(() => document.getElementById('statusTxt').textContent = '', 2000);
                if (isToday) { setTimeout(scrollNow, 400); checkOtBanner(); }
                if (isToday) setTimeout(() => location.reload(), 60000);
            } catch (e) {
                document.getElementById('loadBox').innerHTML = '<div class="text-danger fw-bold mt-4">❌ Không tải được dữ liệu, vui lòng F5 lại</div>';
            }
        }

        // ==========================================
        // RENDER GRID
        // ==========================================
        function renderGrid() {
            if (!schedData.length) {
                document.getElementById('loadBox').innerHTML = '<div style="font-size:56px;opacity:.2">🏸</div><p class="mt-3 text-muted fw-bold">Không có sân nào cho ngày này.</p>';
                return;
            }

            const now = new Date(); const nowMin = now.getHours() * 60 + now.getMinutes();
            const slots = schedData[0].schedule;

            // HEADER
            let head = '<th style="width:120px; color:#64748b; font-size:12px; text-transform:uppercase">CA / SÂN</th>';
            schedData.forEach(c => {
                head += `<th>${c.courtName} ${c.status === 'maintenance' ? '<div style="font-size:11px;color:#fbbf24;margin-top:4px">⚠️ BẢO TRÌ</div>' : ''}</th>`;
            });
            document.getElementById('schedHead').innerHTML = head;

            // BODY
            var bodyRows = '';
            slots.forEach((slot, si) => {
                var parts = slot.time.split(' - ');
                var tStart = (parts[0] || '').trim(), tEnd = (parts[1] || '').trim();
                var sp = tStart.split(':'), ep = tEnd.split(':');
                var startMin = parseInt(sp[0]||0) * 60 + parseInt(sp[1]||0);
                var endMin = parseInt(ep[0]||0) * 60 + parseInt(ep[1]||0);

                var rowActive = isToday && nowMin >= startMin && nowMin < endMin;
                var rowOvertime = isToday && endMin > 0 && nowMin >= endMin;

                bodyRows += `<tr id="row-${si}" class="${rowActive ? 'row-now' : ''}">`;

                bodyRows += `<td class="sch-time-cell">`;
                if (rowActive) bodyRows += `<div class="time-now-badge">Đang đá</div>`;
                bodyRows += `<div class="time-start">${tStart}</div><div class="time-end">${tEnd}</div></td>`;

                schedData.forEach(court => {
                    var s = (si < court.schedule.length) ? court.schedule[si] : null;

                    if (!s || !s.isBooked || !s.bookingInfo) {
                        var maint = court.status === 'maintenance';
                        if (maint) {
                            bodyRows += `<td><div class="slot-maint">🔧</div></td>`;
                        } else {
                            // Ô sân trống => Gọi modal Walk-In
                            bodyRows += `<td>
                                <div class="slot-empty" onclick="openWalkInModal(${court.courtId}, '${court.courtName}', ${s.timeSlotId}, '${s.time}', '${dp.value}')">
                                    <i class="fas fa-plus opacity-50"></i>
                                </div>
                            </td>`;
                        }
                    } else {
                        var b = s.bookingInfo;
                        var isDone = (b.paymentStatus === 'completed');
                        var stateClass, badgeText;

                        if (isDone) { stateClass = 'state-done'; badgeText = 'Đã xong'; }
                        else if (rowOvertime) { stateClass = 'state-overtime'; badgeText = 'Quá giờ'; }
                        else if (rowActive) { stateClass = 'state-active'; badgeText = 'Đang đá'; }
                        else { stateClass = 'state-waiting'; badgeText = 'Chờ đá'; }

                        var onclick = isDone ? '' : `onclick="openBill(${b.bookingId}, ${court.courtId}, '${tEnd}', '${court.courtName}', '${b.customerName}')"`;

                        bodyRows += `<td data-overtime="${rowOvertime && !isDone}" data-cust="${b.customerName}" data-end="${tEnd}">
                            <div class="slot-book ${stateClass}" ${onclick}>
                                <div class="s-name">${b.customerName}</div>
                                <div class="s-phone">📞 ${b.phone}</div>
                                <span class="s-badge">${badgeText}</span>
                            </div></td>`;
                    }
                });
                bodyRows += '</tr>';
            });
            document.getElementById('schedBody').innerHTML = bodyRows;
            document.getElementById('loadBox').style.display = 'none';
            document.getElementById('schedTbl').style.display = '';
        }

        function scrollNow() { var row = document.querySelector('.row-now'); if (row) row.scrollIntoView({ behavior: 'smooth', block: 'center' }); }

        function checkOtBanner() {
            var ots = document.querySelectorAll('[data-overtime="true"]');
            if (!ots.length) return;
            document.getElementById('otBanner').classList.add('show');
            document.getElementById('otNames').innerHTML = Array.from(ots).map(el => `• ${el.dataset.cust} (Ca đến ${el.dataset.end})`).join('<br>');
        }

        // ==========================================
        // BILL & CHECKOUT
        // ==========================================
        async function openBill(bid, cid, slotEnd, cname, custName) {
            curBid = bid; curCourtId = cid; curSlotEnd = slotEnd; curCourtName = cname; curCustName = custName;
            var now = new Date(); var ep = slotEnd.split(':');
            var isOT = isToday && (now.getHours() * 60 + now.getMinutes()) > (parseInt(ep[0]||0) * 60 + parseInt(ep[1]||0));

            document.getElementById('billTitle').textContent = `Chi tiết — ${cname}`;
            document.getElementById('billBody').innerHTML = '<div class="text-center py-4"><div class="spinner-border" style="color:#0f766e"></div></div>';
            document.getElementById('billFoot').style.display = 'none';
            new bootstrap.Modal(document.getElementById('billModal')).show();

            try {
                var r = await fetch(API + '/staff/booking-bill/' + bid, { headers: H });
                curBill = await r.json(); renderBill(curBill, isOT, slotEnd);
                document.getElementById('billFoot').style.display = 'flex';
            } catch { document.getElementById('billBody').innerHTML = '<div class="alert alert-danger fw-bold">Không tải được hóa đơn!</div>'; }
        }

        function renderBill(b, isOT, slotEnd) {
            var fmt = n => new Intl.NumberFormat('vi-VN').format(n || 0) + 'đ';
            var vOpts = (b.availableVouchers || []).map(v => `<option value="${v.code}">${v.label}</option>`).join('');

            var html = isOT ? `<div class="alert alert-danger fw-bold mb-3 p-3 rounded-3" style="border-left:5px solid #ef4444">🚨 Khách đã quá giờ kết thúc (${slotEnd})!</div>` : '';
            html += `<div class="bill-row"><span class="text-muted">Khách hàng</span><span class="text-dark">${b.customerName}</span></div>`;
            html += `<div class="bill-row"><span class="text-muted">Tiền sân</span><span class="text-dark">${fmt(b.courtTotal)}</span></div>`;
            if (b.posTotal > 0) html += `<div class="bill-row"><span class="text-muted">Đồ uống / Dịch vụ</span><span class="text-dark">${fmt(b.posTotal)}</span></div>`;
            if (b.alreadyPaid > 0) html += `<div class="bill-row text-success"><span class="opacity-75">Đã đặt cọc</span><span>− ${fmt(b.alreadyPaid)}</span></div>`;

            html += `<div class="mt-3 p-3 bg-light rounded-3 border">
                        <label class="form-label fw-bold text-muted small mb-2">🎟️ ÁP DỤNG MÃ GIẢM GIÁ</label>
                        <select id="vcSel" class="form-select fw-bold" onchange="recalc()">
                            <option value="">-- Không sử dụng --</option>${vOpts}
                        </select>
                        <div id="vcLine" class="text-success mt-2 fw-bold" style="display:none; font-size:14px"></div>
                     </div>`;
            html += `<div class="bill-total-row"><span>CẦN THU:</span><span class="text-danger" id="finalAmt">${fmt(b.remainingAmount)}</span></div>`;
            document.getElementById('billBody').innerHTML = html;
        }

        function recalc() {
            var fmt = n => new Intl.NumberFormat('vi-VN').format(n || 0) + 'đ';
            var code = document.getElementById('vcSel').value;
            var vc = (curBill.availableVouchers || []).find(v => v.code === code);
            var disc = vc ? vc.discountAmount : 0;
            document.getElementById('finalAmt').textContent = fmt(Math.max(0, curBill.remainingAmount - disc));
            var vl = document.getElementById('vcLine');
            vl.style.display = disc > 0 ? '' : 'none';
            if (disc > 0) vl.textContent = `✅ Đã giảm: − ${fmt(disc)}`;
        }

        async function doCheckout(method) {
            var vc = (document.getElementById('vcSel') || {}).value || '';
            try {
                var r = await fetch(API + '/staff/checkout/' + curBid, { method: 'POST', headers: HJ, body: JSON.stringify({ PaymentMethod: method, VoucherCode: vc }) });
                var d = await r.json();
                bootstrap.Modal.getInstance(document.getElementById('billModal')).hide();
                showToast('✅ ' + (d.message || 'Thanh toán thành công!'), 'success');
                setTimeout(loadSched, 1500);
            } catch { showToast('❌ Lỗi kết nối!', 'danger'); }
        }

        // ==========================================
        // EXTEND BOOKING (GIA HẠN)
        // ==========================================
        function openExtend() {
            document.getElementById('extCustName').textContent = curCustName;
            document.getElementById('extCourtName').textContent = curCourtName;
            document.getElementById('extSlotList').innerHTML = '<div class="text-center py-3"><div class="spinner-border spinner-border-sm text-teal"></div></div>';
            bootstrap.Modal.getInstance(document.getElementById('billModal')).hide();
            new bootstrap.Modal(document.getElementById('extModal')).show();
            buildExtendSlots();
        }

        function buildExtendSlots() {
            var courtIdx = schedData.findIndex(c => c.courtId === curCourtId);
            if (courtIdx < 0) { noSlots(); return; }

            var schedule = schedData[courtIdx].schedule;
            var curSlotIdx = -1;
            schedule.forEach((s, i) => { if (s.bookingInfo && s.bookingInfo.bookingId === curBid) curSlotIdx = i; });

            var nextSlots = [];
            for (var i = curSlotIdx + 1; i < schedule.length && nextSlots.length < 4; i++) {
                var s = schedule[i];
                if (!s.isBooked) { nextSlots.push({ timeSlotId: s.timeSlotId, time: s.time }); }
                else { break; }
            }

            if (!nextSlots.length) { noSlots(); return; }

            document.getElementById('extSlotList').innerHTML = nextSlots.map(ns => `
                <button class="btn-ext" onclick="doExtend(${ns.timeSlotId})">
                    <span class="btn-ext-time">${ns.time}</span>
                    <span class="btn-ext-add">+ Gia hạn</span>
                </button>`).join('');
        }

        function noSlots() {
            document.getElementById('extSlotList').innerHTML = 
                `<div class="alert alert-warning fw-bold text-center border-0" style="background:#fffbeb; color:#b45309">
                    🚫 Ca tiếp theo đã bị người khác đặt hoặc đã hết giờ hoạt động!
                </div>`;
        }

        async function doExtend(nextSlotId) {
            try {
                var r = await fetch(API + '/staff/extend-booking/' + curBid + '?courtId=' + curCourtId + '&nextSlotId=' + nextSlotId, { method: 'POST', headers: HJ });
                var d = await r.json();
                bootstrap.Modal.getInstance(document.getElementById('extModal')).hide();
                if(!r.ok) { showToast('❌ ' + (d.message || 'Lỗi'), 'danger'); return; }
                showToast('✅ ' + (d.message || 'Gia hạn thành công!'), 'success');
                setTimeout(loadSched, 1500);
            } catch { showToast('❌ Lỗi kết nối server!', 'danger'); }
        }

        // ==========================================
        // WALK-IN BOOKING (ĐẶT TẠI CHỖ KÈM DROPDOWN)
        // ==========================================
        function openWalkInModal(courtId, courtName, timeSlotId, timeString, playDate) {
            document.getElementById('walkInCourtId').value = courtId;
            document.getElementById('walkInTimeSlotId').value = timeSlotId;
            document.getElementById('walkInDate').value = playDate; 
            
            document.getElementById('walkInCourtName').textContent = courtName;
            document.getElementById('walkInTime').textContent = timeString;
            
            // Nạp options vào Dropdown từ mảng customerList
            const selectEl = document.getElementById('walkInUserId');
            selectEl.innerHTML = '<option value="" class="text-danger fw-bold">-- Khách Vãng Lai (Không cần tài khoản) --</option>' + 
                                 customerList.map(c => `<option value="${c.id}">${c.fullName} - ${c.phone}</option>`).join('');

            new bootstrap.Modal(document.getElementById('walkInModal')).show();
        }

        async function submitWalkInBooking() {
            const btn = document.getElementById('btnSubmitWalkIn');
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Đang xử lý...';
            btn.disabled = true;

            const selectedUserId = document.getElementById('walkInUserId').value;

            const payload = {
                courtId: parseInt(document.getElementById('walkInCourtId').value),
                timeSlotId: parseInt(document.getElementById('walkInTimeSlotId').value),
                playDate: document.getElementById('walkInDate').value,
                userId: selectedUserId ? parseInt(selectedUserId) : null // Truyền ID khách nếu có chọn
            };

            try {
                const res = await fetch(`${API}/staff/walk-in`, {
                    method: 'POST',
                    headers: HJ,
                    body: JSON.stringify(payload)
                });

                const data = await res.json();
                if (!res.ok) throw new Error(data.message || 'Lỗi hệ thống');

                showToast('✅ ' + data.message, 'success');
                
                bootstrap.Modal.getInstance(document.getElementById('walkInModal')).hide();
                loadSched(); // Tải lại lưới sân ngay lập tức

            } catch (error) {
                showToast('❌ ' + error.message, 'danger');
            } finally {
                btn.innerHTML = '<i class="fas fa-check"></i> Tạo Lịch Đánh Ngay';
                btn.disabled = false;
            }
        }

        // ==========================================
        // UTILS
        // ==========================================
        function showToast(msg, type) {
            var t = document.createElement('div');
            t.style.cssText = `position:fixed;bottom:24px;right:24px;z-index:9999;padding:14px 24px;border-radius:12px;font-weight:700;font-size:15px;color:white;background:${type==='success'?'#0f766e':'#ef4444'};box-shadow:0 10px 30px rgba(0,0,0,.2);transform:translateY(20px);opacity:0;transition:all .3s cubic-bezier(.4,0,.2,1)`;
            t.textContent = msg; document.body.appendChild(t);
            requestAnimationFrame(() => { t.style.transform = 'translateY(0)'; t.style.opacity = '1'; });
            setTimeout(() => { t.style.transform = 'translateY(20px)'; t.style.opacity = '0'; setTimeout(() => t.remove(), 300); }, 3500);
        }
    </script>
}